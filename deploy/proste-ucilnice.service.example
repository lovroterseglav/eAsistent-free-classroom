[Unit]
Description=Proste ucilnice web API
After=network-online.target
Wants=network-online.target

[Service]
User=deploy
WorkingDirectory=/opt/proste-ucilnice/api
EnvironmentFile=/opt/config/proste-ucilnice/env
ExecStart=/usr/bin/node build/src/server.js
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
StateDirectory=proste-ucilnice
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
